        # lstm = tf.keras.layers.Dense(100)(lstm)
        # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(lstm)
        # lstm = tf.keras.layers.Dropout(rate = DROPOUT_RATE(mode))(lstm)
        # lstm = tf.keras.layers.Dense(100)(lstm)
        # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(lstm)
        # lstm = tf.keras.layers.Dropout(rate = DROPOUT_RATE(mode))(lstm)
            
        # lstm = tf.keras.layers.Dense(1)(lstm)
        if self.trainer_config.is_binary_prediction:
            lstm = tf.keras.layers.Dense(1, activation='sigmoid')(lstm)
        elif self.trainer_config.use_quantiles:
            lstm = tf.keras.layers.Dense(len(quantiles))(lstm)
        else:
            lstm = tf.keras.layers.Dense(1)(lstm)
        regressor = tf.keras.models.Model([input_layer, stock_id_input, sector_input, prev_day_input],lstm)
        regressor.summary()
        plot_model(regressor, to_file='regressor_tree.png', show_shapes=True, show_layer_names=True)
        return regressor

    def create_model_simple_v2(self, train_data):

        ### MODEL 1
        from tensorflow.keras.layers import Concatenate, ZeroPadding1D, Cropping1D, Embedding, RepeatVector, Input, Reshape, Conv1D, PReLU, LSTM, Dropout, Dense, Flatten
        
        input_data = train_data.iloc[0]["LstmData"]
        print(input_data.shape)
        
        input_layer = tf.keras.layers.Input(shape=(input_data.shape[0], input_data.shape[1]), name="lstm-values")
        stock_id_input = tf.keras.layers.Input(shape=(1,), name="stock_id")  # Stock ID input
        sector_input = tf.keras.layers.Input(shape=(1,), name="sector_id")  # Sector ID input
        prev_day_input = tf.keras.layers.Input(shape=(len(lstm_features),), name="prev-day-values")
                
#        cnn = tf.keras.layers.Dropout(rate = self.trainer_config.dropout_rate(1))(input_layer)
        cnn = TimeDistributed(Dense(64, kernel_regularizer=l2(self.trainer_config.l2_rate), activation=None))(input_layer)
        cnn = TimeDistributed(BatchNormalization())(cnn)
        cnn = TimeDistributed(LeakyReLU())(cnn)
        cnn = TimeDistributed(Dense(32, kernel_regularizer=l2(self.trainer_config.l2_rate), activation=None))(cnn)
        cnn = TimeDistributed(BatchNormalization())(cnn)
        cnn = TimeDistributed(LeakyReLU())(cnn)
        cnn = TimeDistributed(Dense(32, kernel_regularizer=l2(self.trainer_config.l2_rate), activation=None))(cnn)
        cnn = TimeDistributed(BatchNormalization())(cnn)
        cnn = TimeDistributed(LeakyReLU())(cnn)
        cnn = TimeDistributed(Dense(16, kernel_regularizer=l2(self.trainer_config.l2_rate), activation=None))(cnn)
        cnn = TimeDistributed(BatchNormalization())(cnn)
        cnn = TimeDistributed(LeakyReLU())(cnn)
        cnn = TimeDistributed(Dense(4, kernel_regularizer=l2(self.trainer_config.l2_rate), activation=None))(cnn)
        cnn = TimeDistributed(BatchNormalization())(cnn)
        cnn = TimeDistributed(LeakyReLU())(cnn)

#        cnn = TimeDistributed(Dense(32, kernel_regularizer=l2(self.trainer_config.l2_rate), activation='relu'))(cnn)
#        cnn = TimeDistributed(BatchNormalization())(cnn)
#        cnn = TimeDistributed(Dense(32, kernel_regularizer=l2(self.trainer_config.l2_rate), activation='relu'))(cnn)
#        cnn = TimeDistributed(BatchNormalization())(cnn)
#        cnn = TimeDistributed(Dense(16, kernel_regularizer=l2(self.trainer_config.l2_rate), activation='relu'))(cnn)
#        cnn = TimeDistributed(BatchNormalization())(cnn)
#        cnn = TimeDistributed(Dense(4, activation=None))(cnn)
#        cnn = TimeDistributed(LeakyReLU())(cnn)  # You can adjust alpha if needed

        
        cnn = tf.keras.layers.Conv1D(8,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.05))(cnn)
        
        cnn = tf.keras.layers.Conv1D(8,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.05))(cnn)
        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
        cnn = tf.keras.layers.Conv1D(8, 3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.05))(cnn)
        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
#        cnn = tf.keras.layers.Conv1D(4, 3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
#        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.05))(cnn)
        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
                
#        cnn = tf.keras.layers.Conv1D(1024,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
#        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
#        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
#
#
#        cnn = tf.keras.layers.Conv1D(1024,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
#        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
#        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
#
#
#        cnn = tf.keras.layers.Conv1D(2048,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
#        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
#        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
#
#
#        cnn = tf.keras.layers.Conv1D(2048,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
#        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
#        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
        
        cnn = tf.keras.layers.Flatten()(cnn)
        

        if not self.trainer_config.do_stock_by_stock:
            # Stock Embedding Layer
            num_of_unique_stocks = train_data["Ticker"].nunique()  # Adjust based on the number of unique stocks
            num_of_unique_sectors = train_data["Sector"].nunique()  # Adjust based on the number of unique stocks
            
            # Roll to the nearest higher integer
            stock_embedding_dim = 32 #math.ceil(math.sqrt(num_of_unique_stocks)) * 2
            sector_embedding_dim = 16 #math.ceil(math.sqrt(num_of_unique_sectors)) * 2
            
            stock_embedding = tf.keras.layers.Embedding(input_dim=num_of_unique_stocks, output_dim=stock_embedding_dim, name="stock_embedding")(stock_id_input)
            sector_embedding = tf.keras.layers.Embedding(input_dim=num_of_unique_sectors, output_dim=sector_embedding_dim, name="sector_embedding")(sector_input)
            
            # Reshape to remove the sequence length dimension
            stock_embedding = tf.keras.layers.Reshape((stock_embedding_dim,))(stock_embedding)
            sector_embedding = tf.keras.layers.Reshape((sector_embedding_dim,))(sector_embedding)
        
                
            # Pass embeddings through a dense layer
            stock_embedding = tf.keras.layers.Dense(32, activation='relu', name="stock_dense")(stock_embedding)
            sector_embedding = tf.keras.layers.Dense(16, activation='relu', name="sector_dense")(sector_embedding)
            
            # stock_embedding = tf.keras.layers.Dropout(0.2)(stock_embedding)
            # sector_embedding = tf.keras.layers.Dropout(0.2)(sector_embedding)
            
            # stock_embedding = tf.keras.layers.RepeatVector(cnn.shape[1])(stock_embedding)  # Match timesteps with input data
            cnn = Concatenate(axis=-1)([cnn, stock_embedding])
            
            # sector_embedding = tf.keras.layers.RepeatVector(cnn.shape[1])(sector_embedding)  # Match timesteps with input data
            cnn = Concatenate(axis=-1)([cnn, sector_embedding])


        if self.trainer_config.use_extra_dense_layers:
            extra = tf.keras.layers.Dense(64)(prev_day_input)
            extra = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.05))(extra)
            extra = tf.keras.layers.Dense(4)(extra)
            extra = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.05))(extra)
            cnn = Concatenate(axis=-1)([cnn, extra])


        lstm = cnn
    
        lstm = tf.keras.layers.Dense(8, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
        lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.05))(lstm)
#        lstm = tf.keras.layers.Dropout(rate = self.trainer_config.dropout_rate(1))(lstm)
        
        
#        lstm = tf.keras.layers.Dense(16)(lstm)
#        lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
#        lstm = tf.keras.layers.Dropout(rate = self.trainer_config.dropout_rate(2))(lstm)

#        lstm = tf.keras.layers.Dense(4)(lstm)
#        lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.05))(lstm)
        # lstm = tf.keras.layers.Dense(200)(lstm)
        # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        # lstm = tf.keras.layers.Dense(100)(lstm)
        # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        # lstm = tf.keras.layers.Dense(50)(lstm)
        # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        # lstm = tf.keras.layers.Dense(20)(lstm)
        # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        # lstm = tf.keras.layers.Dense(10)(lstm)
        # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        # lstm = tf.keras.layers.Dense(4)(lstm)
        # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        # lstm = tf.keras.layers.Dense(2, activation='relu')(lstm)
        # lstm = tf.keras.layers.Flatten()(lstm)
            
        # lstm = tf.keras.layers.Dense(1)(lstm)
        if self.trainer_config.is_binary_prediction:
            lstm = tf.keras.layers.Dense(1, activation='sigmoid')(lstm)
        elif self.trainer_config.use_quantiles:
            lstm = tf.keras.layers.Dense(len(quantiles))(lstm)
        else:
            lstm = tf.keras.layers.Dense(1)(lstm)
        regressor = tf.keras.models.Model([input_layer, stock_id_input, sector_input, prev_day_input],lstm)
        regressor.summary()
        plot_model(regressor, to_file='regressor_tree.png', show_shapes=True, show_layer_names=True)
        
        return regressor
        
        
    def create_model_simple_v3(self, train_data, prediction_size=1):
        ### MODEL 1
        from tensorflow.keras.layers import Concatenate, ZeroPadding1D, Cropping1D, Embedding, RepeatVector, Input, Reshape, Conv1D, PReLU, LSTM, Dropout, Dense, Flatten
        
        input_data = train_data.iloc[0]["LstmData"]
        print(input_data.shape)
        
        input_layer = tf.keras.layers.Input(shape=(input_data.shape[0], input_data.shape[1]), name="lstm-values")
        stock_id_input = tf.keras.layers.Input(shape=(1,), name="stock_id")  # Stock ID input
        sector_input = tf.keras.layers.Input(shape=(1,), name="sector_id")  # Sector ID input
        prev_day_input = tf.keras.layers.Input(shape=(len(lstm_features),), name="prev-day-values")
        
        cnn = input_layer
        
#        cnn = BatchNormalization()(cnn)
        cnn = tf.keras.layers.Conv1D(16,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
#        cnn = BatchNormalization()(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1])(cnn)
        
        cnn = tf.keras.layers.Conv1D(32,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
#        cnn = BatchNormalization()(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1])(cnn)

        cnn = tf.keras.layers.Conv1D(32,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
#        cnn = BatchNormalization()(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1])(cnn)
#

        cnn = tf.keras.layers.Conv1D(32,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
#        cnn = BatchNormalization()(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1])(cnn)

        cnn = tf.keras.layers.Flatten()(cnn)
        
        lstm = cnn

        lstm = tf.keras.layers.Dense(32, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
#        lstm = BatchNormalization()(lstm)
        lstm = tf.keras.layers.PReLU(shared_axes=[1])(lstm)


#         lstm = tf.keras.layers.Dense(16, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
# #        lstm = BatchNormalization()(lstm)
#         lstm = tf.keras.layers.PReLU(shared_axes=[1])(lstm)
        
        
#        lstm = tf.keras.layers.Dense(16, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
##        lstm = BatchNormalization()(lstm)
#        lstm = tf.keras.layers.PReLU(shared_axes=[1])(lstm)
#        lstm = tf.keras.layers.Dense(4, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
#        lstm = tf.keras.layers.PReLU(shared_axes=[1])(lstm)
        
        if self.trainer_config.is_binary_prediction:
            lstm = tf.keras.layers.Dense(3, activation='sigmoid')(lstm)
        elif self.trainer_config.use_quantiles:
            lstm = tf.keras.layers.Dense(len(quantiles))(lstm)
        else:
            lstm = tf.keras.layers.Dense(1)(lstm)
        regressor = tf.keras.models.Model([input_layer, stock_id_input, sector_input, prev_day_input],lstm)
        regressor.summary()
        plot_model(regressor, to_file='regressor_tree.png', show_shapes=True, show_layer_names=True)
        return regressor
        
    def create_model(self, train_data, prediction_size=1):

        if self.trainer_config.network_type == "experimental":
            return self.create_model_experimental(train_data)
        elif self.trainer_config.network_type == "experimental_v2":
            return self.create_model_experimental_v2(train_data)
        elif self.trainer_config.network_type == "experimental_v3":
            return self.create_model_experimental_v3(train_data)
        elif self.trainer_config.network_type == "experimental_v4":
            return self.create_model_experimental_v4(train_data)
        elif self.trainer_config.network_type == "experimental_v5":
            return self.create_model_experimental_v5(train_data)
        elif self.trainer_config.network_type == "experimental_v6":
            return self.create_model_experimental_v6(train_data)
        elif self.trainer_config.network_type == "simple_v2":
            return self.create_model_simple_v2(train_data)
        elif self.trainer_config.network_type == "simple_v3":
            return self.create_model_simple_v3(train_data, prediction_size)
            
        ### MODEL 1
        from tensorflow.keras.layers import Concatenate, ZeroPadding1D, Cropping1D, Embedding, RepeatVector, Input, Reshape, Conv1D, PReLU, LSTM, Dropout, Dense, Flatten
        
        input_data = train_data.iloc[0]["LstmData"]
        print(input_data.shape)
        
        input_layer = tf.keras.layers.Input(shape=(input_data.shape[0], input_data.shape[1]), name="lstm-values")
        stock_id_input = tf.keras.layers.Input(shape=(1,), name="stock_id")  # Stock ID input
        sector_input = tf.keras.layers.Input(shape=(1,), name="sector_id")  # Sector ID input
        prev_day_input = tf.keras.layers.Input(shape=(len(lstm_features),), name="prev-day-values")
        
        cnn = tf.keras.layers.Conv1D(256,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(input_layer)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
        # cnn = tf.keras.layers.AveragePooling1D(pool_size=2)(cnn)
        cnn = tf.keras.layers.Conv1D(256,3, strides=2,kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
        cnn = tf.keras.layers.Conv1D(512,3, strides=2,kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
        cnn = tf.keras.layers.Conv1D(512,3, strides=2,kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
        # cnn = tf.keras.layers.MaxPooling1D(pool_size=2)(cnn)
        if self.trainer_config.network_type == "complex" or self.trainer_config.network_type == "medium":
            cnn = tf.keras.layers.Conv1D(1024,3, strides=2,kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
            cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
        if self.trainer_config.network_type == "complex":
            cnn = tf.keras.layers.Conv1D(1024,3, strides=2,kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
            cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0))(cnn)
        
        cnn = tf.keras.layers.Flatten()(cnn)
        
        # cnn = tf.keras.layers.Dense(800)(cnn)
        # cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(cnn)
        # cnn = tf.keras.layers.Dense(800)(cnn)
        # cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(cnn)
        # cnn = tf.keras.layers.Conv1D(512,3, kernel_regularizer=l2(0.00001))(cnn)
        # cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.25))(cnn)
        # cnn = tf.keras.layers.Conv1D(512,3, kernel_regularizer=l2(0.00001))(cnn)
        # cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.25))(cnn)
        # cnn = tf.keras.layers.Conv1D(1024,3, kernel_regularizer=l2(0.00001))(cnn)
        # cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.25))(cnn)

        if self.trainer_config.use_extra_dense_layers:
            extra = tf.keras.layers.Dense(200)(prev_day_input)
            extra = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(extra)
            extra = tf.keras.layers.Dense(200)(extra)
            extra = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(extra)
            extra = tf.keras.layers.Dense(100)(extra)
            extra = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(extra)
            cnn = Concatenate(axis=-1)([cnn, extra])

        if not self.trainer_config.do_stock_by_stock:
            # Stock Embedding Layer
            num_of_unique_stocks = train_data["Ticker"].nunique()  # Adjust based on the number of unique stocks
            num_of_unique_sectors = train_data["Sector"].nunique()  # Adjust based on the number of unique stocks
            
            # Roll to the nearest higher integer
            stock_embedding_dim = 512 #math.ceil(math.sqrt(num_of_unique_stocks)) * 2
            sector_embedding_dim = 128 #math.ceil(math.sqrt(num_of_unique_sectors)) * 2
            
            stock_embedding = tf.keras.layers.Embedding(input_dim=num_of_unique_stocks, output_dim=stock_embedding_dim, name="stock_embedding")(stock_id_input)
            sector_embedding = tf.keras.layers.Embedding(input_dim=num_of_unique_sectors, output_dim=sector_embedding_dim, name="sector_embedding")(sector_input)
            
            # Reshape to remove the sequence length dimension
            stock_embedding = tf.keras.layers.Reshape((stock_embedding_dim,))(stock_embedding)
            sector_embedding = tf.keras.layers.Reshape((sector_embedding_dim,))(sector_embedding)
        
                
            # Pass embeddings through a dense layer
            stock_embedding = tf.keras.layers.Dense(512, activation='relu', name="stock_dense")(stock_embedding)
            sector_embedding = tf.keras.layers.Dense(256, activation='relu', name="sector_dense")(sector_embedding)
            
            # stock_embedding = tf.keras.layers.Dropout(0.2)(stock_embedding)
            # sector_embedding = tf.keras.layers.Dropout(0.2)(sector_embedding)
            
            # stock_embedding = tf.keras.layers.RepeatVector(cnn.shape[1])(stock_embedding)  # Match timesteps with input data
            cnn = Concatenate(axis=-1)([cnn, stock_embedding])
            
            # sector_embedding = tf.keras.layers.RepeatVector(cnn.shape[1])(sector_embedding)  # Match timesteps with input data
            cnn = Concatenate(axis=-1)([cnn, sector_embedding])

        lstm = cnn
        
        if self.trainer_config.network_type == "lstm" or self.trainer_config.network_type == "lstm+cnn":
            lstm = tf.keras.layers.LSTM(units = 800, return_sequences = True)(lstm)
            lstm = tf.keras.layers.Dropout(rate = 0.2)(lstm)
            lstm = tf.keras.layers.LSTM(units = 400, return_sequences = True)(lstm)
            lstm = tf.keras.layers.Dropout(rate = 0.2)(lstm)
            lstm = tf.keras.layers.LSTM(units = 200, return_sequences = True)(lstm)
            lstm = tf.keras.layers.Dropout(rate = 0.2)(lstm)
            lstm = tf.keras.layers.LSTM(units = 100)(lstm)
            lstm = tf.keras.layers.Dropout(rate = 0.2)(lstm)
        else:
            if self.trainer_config.network_type == "complex" or self.trainer_config.network_type == "medium":
                # Below is needed so we take away all the dimensions from the CNN (channels)
                lstm = tf.keras.layers.Dense(2000)(lstm)
                lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
                lstm = tf.keras.layers.Dropout(rate = self.trainer_config.dropout_rate(1))(lstm)
            # lstm = tf.keras.layers.Dense(4000)(lstm)
            # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            # lstm = tf.keras.layers.Dropout(rate = 0.1)(lstm)
            lstm = tf.keras.layers.Dense(400)(lstm)
            lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            lstm = tf.keras.layers.Dropout(rate = self.trainer_config.dropout_rate(2))(lstm)
            # lstm = tf.keras.layers.Dense(1000)(lstm)
            # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            # lstm = tf.keras.layers.Dropout(rate = 0.1)(lstm)
            # lstm = tf.keras.layers.Dense(250)(lstm)
            # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            # lstm = tf.keras.layers.Dropout(rate = 0.1)(lstm)
            lstm = tf.keras.layers.Dense(100)(lstm)
            lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            lstm = tf.keras.layers.Dropout(rate = self.trainer_config.dropout_rate(3))(lstm)
            # lstm = tf.keras.layers.Dense(200)(lstm)
            # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            # lstm = tf.keras.layers.Dense(100)(lstm)
            # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            # lstm = tf.keras.layers.Dense(50)(lstm)
            # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            # lstm = tf.keras.layers.Dense(20)(lstm)
            # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            # lstm = tf.keras.layers.Dense(10)(lstm)
            # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            # lstm = tf.keras.layers.Dense(4)(lstm)
            # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
            # lstm = tf.keras.layers.Dense(2, activation='relu')(lstm)
            # lstm = tf.keras.layers.Flatten()(lstm)
            
        # lstm = tf.keras.layers.Dense(1)(lstm)
        if self.trainer_config.is_binary_prediction:
            lstm = tf.keras.layers.Dense(1, activation='sigmoid')(lstm)
        elif self.trainer_config.use_quantiles:
            lstm = tf.keras.layers.Dense(len(quantiles))(lstm)
        else:
            lstm = tf.keras.layers.Dense(1)(lstm)
        regressor = tf.keras.models.Model([input_layer, stock_id_input, sector_input, prev_day_input],lstm)
        regressor.summary()
        plot_model(regressor, to_file='regressor_tree.png', show_shapes=True, show_layer_names=True)
        
        return regressor
        
    def start_training(self):

        gc.collect()

        self.setup_for_training()
        
        stock_target_mapping = pd.DataFrame()
        
        # Enable eager execution
        tf.compat.v1.enable_eager_execution()
        print(f"Executing Eagerly?: {tf.executing_eagerly()}")
        
        if self.trainer_config.do_stock_by_stock:
            folder = "..//models//" + self.trainer_config.stocks[0] + "//" + self.trainer_config.network_type + "//"
        else:
            stock = "COMBINED"
            folder = "..//models//COMBINED//" + self.trainer_config.network_type + "//"

        folder = folder + self.trainer_config.network_type + "//"
        if isinstance(self.trainer_config.underlying_target, list):
            folder_extended = folder + '_'.join(self.trainer_config.underlying_target)
        else:
            folder_extended = folder + self.trainer_config.underlying_target
        
        directory = Path(folder)
        directory.mkdir(parents=True, exist_ok=True)
        
        file_name_variable = f"{self.trainer_config.underlying_target}"
        model_name = f"{file_name_variable}.keras"
        
        # Create the ReduceLROnPlateau callback
        reduce_lr = ReduceLROnPlateau(
            monitor=self.trainer_config.early_stop_monitor_metric,     # Metric to monitor
            factor=0.5,             # Factor to reduce the learning rate (new_lr = lr * factor)
            patience=REDUCE_LR_PATIENCE,             # Number of epochs with no improvement before reducing
            min_lr=1e-11,# Minimum learning rate
            mode=self.trainer_config.early_stop_monitor_mode,
            verbose=1
        )
        
        # EarlyStopping to stop training
        early_stopping = EarlyStopping(
            monitor=self.trainer_config.early_stop_monitor_metric,
            patience=self.trainer_config.early_stop_epoch,
            restore_best_weights=True,
            mode=self.trainer_config.early_stop_monitor_mode,
            min_delta=self.trainer_config.early_stop_delta
        )
        
        # Configure logging
        logging.basicConfig(
            filename= folder + f"training_output_{file_name_variable}.log",
            level=logging.INFO,
            format='%(asctime)s - %(message)s'
        )
        logger = logging.getLogger()
        
        # Define a custom callback to log training progress
        class LogCallback(tf.keras.callbacks.Callback):
            def on_epoch_end(self, epoch, logs=None):
                logger.info(f"Epoch {epoch + 1}: {logs}")
        
        log_dir = "logs/fit/" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        tensorboard_callback = tf.keras.callbacks.TensorBoard(log_dir=log_dir, histogram_freq=1)
        
        
        train_data, validation_data, test_data, two_sigma_cap_per_ticker, real_target = self.construct_data()
        
        if self.trainer_config.is_binary_prediction and self.trainer_config.do_stock_by_stock:
            # Handle each target separately if we have multiple targets
            if isinstance(self.trainer_config.underlying_target, list):
                for idx, target in enumerate(self.trainer_config.underlying_target):
                    # Get target-specific mean and sigma values (extract the idx-th element from the lists)
                    target_mean = validation_data.iloc[-1]['Target-20D-Mean']
                    target_sigma = validation_data.iloc[-1]['Target-20D-Sigma']
                    
                    # Special case for "Next-Day-Low-To-Next-Day-Open-Ratio"
                    if target == "Next-Day-Low-To-Next-Day-Open-Ratio":
                        if isinstance(target_mean, list) and len(target_mean) > idx:
                            binary_target_val = target_mean[idx] - target_sigma[idx]
                        else:
                            binary_target_val = target_mean - target_sigma
                    else:
                        if isinstance(target_mean, list) and len(target_mean) > idx:
                            binary_target_val = target_mean[idx] + target_sigma[idx]
                        else:
                            binary_target_val = target_mean + target_sigma

                    individual_target_mapping = pd.DataFrame([{
                        'Ticker': self.trainer_config.stocks[0], 
                        'Target': target, 
                        'Target-Val': binary_target_val
                    }])
                    individual_target_mapping.to_csv(os.path.join(folder, f"{target}_binary_target_val.csv"), index=False)
            else:
                binary_target_val = validation_data.iloc[-1]['Target-20D-Mean'] + validation_data.iloc[-1]['Target-20D-Sigma']
                stock_target_mapping = pd.concat([stock_target_mapping, pd.DataFrame([{'Ticker': self.trainer_config.stocks[0], 'Target': self.trainer_config.underlying_target, 'Target-Val': binary_target_val}])])
                stock_target_mapping.to_csv(folder + f"{self.trainer_config.underlying_target}_binary_target_val.csv", index=False)
        
        lr_schedule = tf.keras.optimizers.schedules.ExponentialDecay(
            initial_learning_rate=self.trainer_config.initial_learning_rate,
            decay_steps=self.trainer_config.decay_interval,
            decay_rate=self.trainer_config.decay_ratio,
            staircase=True
        )

        optimizer = Adam(learning_rate=lr_schedule)
        
        if self.trainer_config.is_binary_prediction:
            count_1 = (train_data['y-value-original'] == 1.0).sum()
            count_0 = (train_data['y-value-original'] == 0.0).sum()
            ratio = count_0 / count_1
            print(f"RATIO::: of y-values = 0 vs 1: {ratio}")
            loss, loss_name = calculate_loss(self.trainer_config.loss_function, ratio)
        else:
            loss, loss_name = calculate_loss(self.trainer_config.loss_function)
        
        
        # Display rows with NaN values
        nan_rows = train_data[train_data.isnull().any(axis=1)]
        print("Rows with NaN values:")
        print(nan_rows)
        
        # Find specific columns with NaN
        nan_cols = train_data.columns[train_data.isnull().any()].tolist()
        print("Columns with NaN values:", nan_cols)
        
        
        ### Let's convert all of our stuff to np arrays to avoid any indexing issues:
        X_train = np.array(train_data["LstmData"].to_list())
        X_train_ticker = np.array(train_data["Ticker"].to_list())
        X_train_sector = np.array(train_data["Sector"].to_list())
        y_train = np.array(train_data["y-value"].to_list())
        
        X_validate = np.array(validation_data["LstmData"].to_list())
        X_validate_ticker = np.array(validation_data["Ticker"].to_list())
        X_validate_sector = np.array(validation_data["Sector"].to_list())
        y_validate = np.array(validation_data["y-value"].to_list())
        
        sample_weight = np.array([])
        for ticker in train_data["Orig_Ticker"].unique():
            sample_weight = np.append(sample_weight, np.linspace(0.6, 1.4, len(train_data[train_data["Orig_Ticker"] == ticker])))
        
        exp_weights = np.exp(np.linspace(0, 1, len(X_train))) - 1  # Shifted to start near 0
        exp_weights = exp_weights / exp_weights.max() * 2.0  # Scale to 0-2 range
    
        nan_rows = np.where(np.isnan(X_train).any(axis=1))[0]  # Get indices of rows with NaN values
        if nan_rows.any():
            nan_rows_tickers = train_data.iloc[nan_rows]
            print(f"{nan_rows_tickers['Orig_Ticker']}")
        
        assert not np.any(np.isnan(X_train)), "Train Data contains NaN values!"
        assert not np.any(np.isinf(X_train)), "Train Data contains infinite values!"
        
        assert not np.any(np.isnan(X_validate)), "Validate Data contains NaN values!"
        assert not np.any(np.isinf(X_validate)), "Validate Data contains infinite values!"
        
        
        
        print(f"\n\n PRINTING NEW STUFF \n\n")
        print(train_data.iloc[0][lstm_features].shape)
        print(train_data.iloc[0][lstm_features])
        print(train_data.iloc[0]["LstmData"])
        print(f"\n\n END OF NEW STUFF \n\n")

        metrics = [
                    precision_with_threshold(0.7),  # Custom precision
                    recall_with_threshold(0.7),    # Custom recall
                    # 'AUC',                         # Built-in AUC
                    'Precision',                   # Built-in Precision
                    'Recall',                      # Built-in Recall
                    tf.keras.metrics.AUC(name='AUC-ROC', curve='ROC'),  # Default is ROC
                    tf.keras.metrics.AUC(name='AUC-PR', curve='PR'),  # Precision-Recall AUC
                    tf.keras.metrics.AUC(name='output_1_AUC-ROC', curve='ROC'),  # Default is ROC
                    tf.keras.metrics.AUC(name='output_1_AUC-PR', curve='PR'),  # Precision-Recall AUC
                    tf.keras.metrics.AUC(name='output_2_AUC-ROC', curve='ROC'),  # Default is ROC
                    tf.keras.metrics.AUC(name='output_2_AUC-PR', curve='PR'),  # Precision-Recall AUC
                    f1_score_metric,                # Custom F1 score
                    true_positives,
                    all_positives,
                    recall_mul_prediction
                    ]
        network = self.create_model(train_data, len(self.trainer_config.underlying_target))
        network.compile(
            optimizer=optimizer,
            loss=loss,
            metrics=metrics
        )
        
        # model_name = f"model_{file_name_variable}-trial-{trial.number}-type-{network_type}-seq-len-{seq_len}.keras"
        # best_model_checkpoint_callback = ModelCheckpoint(
        #     folder + model_name,
        #     monitor=save_best_metric,
        #     save_best_only=True,
        #     mode=save_best_mode,
        #     verbose=0)
        
        from tensorflow.keras.callbacks import ModelCheckpoint, Callback
        # Define a custom callback that enables ModelCheckpoint after epoch 10
        class DelayedSaveBestCheckpoint(Callback):
            def __init__(self, filepath, monitor=self.trainer_config.save_best_metric, mode=self.trainer_config.save_best_mode, save_best_only=True, start_epoch=15):
                super().__init__()
                self.checkpoint = ModelCheckpoint(filepath, monitor=monitor, mode=mode, save_best_only=save_best_only)
                self.start_epoch = start_epoch  # The epoch from which saving should start
        
            def on_train_begin(self, logs=None):
                """Assign the model properly when training begins."""
                self.checkpoint.set_model(self.model)  # ✅ Correctly set the model reference
        
            def on_epoch_end(self, epoch, logs=None):
                if epoch >= self.start_epoch:
                    self.checkpoint.on_epoch_end(epoch, logs)  # ✅ Save the best model only after start_epoch
        
        # Instantiate the custom callback
        delayed_saveback_checkpoint_callback = DelayedSaveBestCheckpoint(
            filepath=folder + model_name,
            monitor=self.trainer_config.save_best_metric,
            mode=self.trainer_config.save_best_mode,
            save_best_only=True,
            start_epoch=self.trainer_config.wait_to_save  # Start saving after epoch WAIT_TO_SAVE
        )


        print(f"y_train: {y_train}")
        print(f"y_validate: {y_validate}")
        tf.keras.config.disable_traceback_filtering()
        # Training the model
        history = network.fit(
            [X_train, X_train_ticker, X_train_sector, train_data[lstm_features].to_numpy()]
            ,y_train
            ,validation_data=([X_validate, X_validate_ticker, X_validate_sector, validation_data[lstm_features].to_numpy()], y_validate)
            ,epochs=self.trainer_config.number_of_epochs
            ,batch_size = self.trainer_config.batch_size
            ,callbacks = [delayed_saveback_checkpoint_callback, reduce_lr, early_stopping, LogCallback(), tensorboard_callback]
            ,sample_weight=sample_weight
        )
        
        evaluator = Evaluator(self.trainer_config)

        evaluator.plot_training_history(history, folder_extended)
        val_best = max(history.history[self.trainer_config.save_best_metric])  # Get the max validation AUC

        try:
            network.load_weights(folder + model_name)
        except Exception as e:
            print(f"Seems NOTHING IS SAVED. TRAINING FAILED")
            return val_best


        y_train_predict = network.predict([X_train, X_train_ticker, X_train_sector, train_data[lstm_features].to_numpy()])
        y_validate_predict = network.predict([X_validate, X_validate_ticker, X_validate_sector, validation_data[lstm_features].to_numpy()])
        
        # For non-quantile case, we still want individual target files if we have multiple targets
        if isinstance(self.trainer_config.underlying_target, list):
            # Process each target separately even when not using quantiles
            for idx, target in enumerate(self.trainer_config.underlying_target):
                # Extract predictions for this specific target index
                y_validate_predict_per_target = y_validate_predict[:, idx] if y_validate_predict.ndim > 1 else y_validate_predict
                y_train_predict_per_target = y_train_predict[:, idx] if y_train_predict.ndim > 1 else y_train_predict
                
                # Pass the specific target instead of the full list, along with the target index
                current_real_target = real_target[idx] if isinstance(real_target, list) else real_target
                
                individual_folder = folder + target
                evaluator.calculate_predictions(train_data, validation_data, y_train_predict_per_target, y_validate_predict_per_target, current_real_target, self.trainer_config.stocks[0], individual_folder, "", target_index=idx)
        else:
            # Single target case
            evaluator.calculate_predictions(train_data, validation_data, y_train_predict, y_validate_predict, real_target, self.trainer_config.stocks[0], folder_extended, "", target_index=None)
            
        del train_data
        del validation_data
        del history
        del network
        del test_data
        del X_train
        del X_train_ticker
        del X_train_sector
        del y_train
        
        del X_validate
        del X_validate_ticker
        del X_validate_sector
        del y_validate

        K.clear_session()
        
        gc.collect()
        
        return val_best  # Optuna tries to maximize this value


    
# Define chart colors
train_actual_color = "cornflowerblue"
validate_actual_color = "orange"
test_actual_color = "green"
train_predicted_color = "lightblue"
validate_predicted_color = "peru"
test_predicted_color = "limegreen"

class Evaluator:

    def __init__(self, trainer_config):
        self.trainer_config = trainer_config

    def calculate_for(self, validation_data, folder, val=0, two_sigma_cap_per_ticker=None, min_threshold=0.01, max_threshold=0.03):
        # Determine the number of elements in the lists
        num_elements = len(validation_data.iloc[0]['y-predict-original'])
        
        # Results storage for each element in the lists
        all_scores = []
        
        for i in range(num_elements):
            print(f"\n--- Processing element {i} ---")
            
            # Create a copy of validation data for this element
            element_data = validation_data.copy()
            
            # Get the appropriate threshold value for this element
            val_i = val[i] if isinstance(val, dict) or isinstance(val, list) else val
            min_threshold_i = min_threshold[i] if isinstance(min_threshold, dict) or isinstance(min_threshold, list) else min_threshold
            
            # Extract the i-th element from each list
            if not self.trainer_config.is_binary_prediction:
                if use_pre_calc_sigma:
                    element_data['y-predict-binary'] = element_data['y-predict-original'].apply(lambda x: 1 if x[i] > min_threshold_i else 0)
                    element_data['y-value-binary'] = element_data['y-value-original'].apply(lambda x: 1 if x[i] > min_threshold_i else 0)
                elif two_sigma_cap_per_ticker is not None:
                    for ticker in element_data["Orig_Ticker"].unique():
                        two_sigma = two_sigma_cap_per_ticker[two_sigma_cap_per_ticker["Orig_Ticker"] == ticker].iloc[0]["2-sigma"]
                        element_data.loc[element_data["Orig_Ticker"] == ticker, 'y-predict-binary'] = element_data.loc[element_data["Orig_Ticker"] == ticker, 'y-predict-original'].apply(lambda x: 1 if x[i] > two_sigma else 0)
                        element_data.loc[element_data["Orig_Ticker"] == ticker, 'y-value-binary'] = element_data.loc[element_data["Orig_Ticker"] == ticker, 'y-value-original'].apply(lambda x: 1 if x[i] > two_sigma else 0)
            else:
                element_data.loc[:,'y-predict-binary'] = element_data['y-predict-original'].apply(lambda x: 1 if x[i] > val_i else 0)
                element_data.loc[:,'y-value-binary'] = element_data['y-value-original'].apply(lambda x: 1 if x[i] > val_i else 0)
                
            # Calculate true positives, false positives, and false negatives
            element_data.loc[:,'true-positive'] = (element_data["y-predict-binary"] == 1.0) & (element_data["y-value-binary"] == 1.0)
            element_data.loc[:,'false-positive'] = (element_data["y-predict-binary"] == 1.0) & (element_data["y-value-binary"] == 0.0)
            element_data.loc[:,'false-negative'] = (element_data["y-predict-binary"] == 0.0) & (element_data["y-value-binary"] == 1.0)

            tps = element_data['true-positive'].sum()
            fps = element_data['false-positive'].sum()
            fns = element_data['false-negative'].sum()
            real_trues = element_data['y-value-binary'].sum()
            all_values = len(element_data)
            
            print(f"Number of true positives for element {i}: {tps}")
            print(f"Number of false positives for element {i}: {fps}")
            precision = tps / (tps + fps) if (tps + fps) > 0 else 0
            recall = tps / (tps + fns) if (tps + fns) > 0 else 0
            print(f"Precision score: {precision}")
            print(f"Recall score: {recall}")
            print(f"Random guess score: {real_trues / all_values}")

            # Calculate per ticker statistics
            all_per_ticker = element_data.groupby('Orig_Ticker').size()
            tp_per_ticker = element_data.groupby('Orig_Ticker')['true-positive'].sum()
            fp_per_ticker = element_data.groupby('Orig_Ticker')['false-positive'].sum()
            fn_per_ticker = element_data.groupby('Orig_Ticker')['false-negative'].sum()
            
            # Handle division by zero
            precision_per_ticker = tp_per_ticker / (tp_per_ticker + fp_per_ticker).replace(0, float('inf'))
            precision_per_ticker = precision_per_ticker.replace(float('inf'), 0)
            
            recall_per_ticker = tp_per_ticker / (tp_per_ticker + fn_per_ticker).replace(0, float('inf'))
            recall_per_ticker = recall_per_ticker.replace(float('inf'), 0)
            
            rand_guess_per_ticker = (tp_per_ticker + fn_per_ticker) / all_per_ticker
            
            print(f"true-positive per ticker: {tp_per_ticker}")
            print(f"false-positive per ticker: {fp_per_ticker}")
            print(f"false-negative per ticker: {fn_per_ticker}")
            print(f"precision per ticker: {precision_per_ticker}")
            print(f"recall per ticker: {recall_per_ticker}")
            print(f"rand guess per ticker: {rand_guess_per_ticker}")

            if self.trainer_config.is_binary_prediction:
                print_true = element_data[element_data['true-positive'] == 1.0][["Date", "Orig_Ticker", "y-predict-binary", "y-value-binary", "Target-20D-Mean", "Target-20D-Sigma"]]
                print_false = element_data[element_data['false-positive'] == 1.0][["Date", "Orig_Ticker", "y-predict-binary", "y-value-binary", "Target-20D-Mean", "Target-20D-Sigma"]]
                
                print(f"Some true positives for element {i}")
                print(print_true.sample(n=min(5, len(print_true)), random_state=42))
            
                print(f"Some false positives for element {i}")
                print(print_false.sample(n=min(5, len(print_false)), random_state=42))

            # Calculate score
            score = (recall_per_ticker > 0.0) * (precision_per_ticker / rand_guess_per_ticker.replace(0, float('inf')))
            score = score.replace(float('inf'), 0)
            
            gain = 0.02 * tps
            loss = 0.01 * fps
            
            print(f"gain is: {gain} and loss is {loss}")
            print(f"Effective gain is: {gain - loss}")
            print(f"Score per ticker for element {i} is: {score}")
            print(f"Total score for element {i} is: {score.sum()}")
            
            all_scores.append(score.sum())
            
            # Plotting for element i
            ticker_to_show = validation_data.iloc[0]["Orig_Ticker"]
            ticker_data = element_data[element_data['Orig_Ticker'] == ticker_to_show]

            if self.trainer_config.is_binary_prediction:
                # Plot actual and predicted price
                plt.figure(figsize=(18,6))
                plt.plot(ticker_data['y-predict-binary'], label=f"{ticker_to_show} Prediction Values (Element {i})", color=train_predicted_color, marker='o', linestyle='')
                plt.plot(ticker_data['y-value-binary'], label=f"{ticker_to_show} Real Values (Element {i})", color=train_predicted_color, marker='x', linestyle='')
                plt.title(f"Test results - Element {i}")
                plt.xlabel("Time")
                plt.ylabel("Binary Prediction - True/False positives")
                plt.xticks(rotation=45)
                plt.legend()
                plt.grid(color="lightgray")
                plt.savefig(folder + f"Inverse-normalized-real-vs-predicted-element-{i}.png")
                plt.show(block=False)
            else:
                # Create a copy of original data to extract i-th element
                y_predict_i = validation_data[validation_data['Orig_Ticker'] == ticker_to_show]['y-predict-original'].apply(lambda x: x[i])
                y_value_i = validation_data[validation_data['Orig_Ticker'] == ticker_to_show]['y-value-original'].apply(lambda x: x[i])
                
                plt.figure(figsize=(18,6))
                plt.plot(y_predict_i.values, label=f"{ticker_to_show} Prediction Values (Element {i})", color=train_predicted_color, marker='o', linestyle='')
                plt.plot(y_value_i.values, label=f"{ticker_to_show} Real Values (Element {i})", color=train_predicted_color, marker='x', linestyle='')
                plt.title(f"Test results - Element {i}")
                plt.xlabel("Time")
                plt.ylabel("Outright Prediction")
                plt.xticks(rotation=45)
                plt.legend()
                plt.grid(color="lightgray")
                plt.savefig(folder + f"outright-prediction-normalized-real-vs-predicted-element-{i}.png")
                plt.show(block=False)

        # Combine and plot overall results
        print("\n--- Overall Results ---")
        print(f"Scores for all elements: {all_scores}")
        print(f"Average score: {sum(all_scores) / len(all_scores)}")
        print(f"Max score: {max(all_scores)} (Element {all_scores.index(max(all_scores))})")
        
        plt.figure(figsize=(12, 6))
        plt.bar(range(len(all_scores)), all_scores)
        plt.title("Scores Across All Elements")
        plt.xlabel("Element Index")
        plt.ylabel("Score")
        plt.grid(color="lightgray", alpha=0.5)
        plt.savefig(folder + "all-elements-scores.png")
        plt.show(block=False)
        
        return max(all_scores)  # Return the best score
    
    def print_and_save_for(self, data, title, folder, label, target_index=None):
    
        max_len = data['y-predict-original'].apply(lambda val: len(val) if isinstance(val, (list, tuple)) else 0).max()

        # Filter data by ticker first
        ticker = data['Orig_Ticker'].unique()[0]
        data = data[data['Orig_Ticker'] == ticker]
        
        # If target_index is specified, only plot that specific target
        if target_index is not None:
            indices_to_plot = [target_index]
        else:
            indices_to_plot = range(max_len)
        
        for i in indices_to_plot:
            # Extract predictions AFTER filtering the data
            pred_i = data['y-predict'].apply(
                lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
            )
            val_i = data['y-value'].apply(
                lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
            )

            print(f"\n\nprint_and_save_for")
            print(f"ticker data: {ticker}\n\n")
            print(f"Here is the data: {data} \n\n\n")
            
            plt.figure(figsize=(18,6))
            plt.plot(data['Date'], pred_i, label=f'Prediction {i} {ticker}', marker='o', linestyle='')
            plt.plot(data['Date'], val_i, label=f'Value {i} {ticker}', marker='x', linestyle='')
            plt.title(f"{title} results")
            plt.xlabel("Time")
            plt.ylabel("Prediction")
            plt.xticks(rotation=45)
            plt.legend()
            plt.grid(color="lightgray")
            plt.savefig(folder + "-Real-vs-prediction-values-" + title + ".png")
            plt.show(block=False)
            print(f"DONE PLOTTING \n\n")

    def plot_precision_recall_curve(self, data_frame, folder, name="All Tickers"):
        max_len = data_frame['y-predict-original'].apply(
            lambda val: len(val) if isinstance(val, (list, tuple)) else 0
        ).max()

        for i in range(max_len):

            if hasattr(self.trainer_config, "underlying_target"):
                target_name = self.trainer_config.underlying_target[i]
            else:
                target_name = f"prediction_{i}"

            # Extract i-th prediction/target
            pred_i = data_frame['y-predict'].apply(
                lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
            )
            val_i = data_frame['y-value'].apply(
                lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
            )

            # Drop invalid
            valid = pd.DataFrame({'pred': pred_i, 'val': val_i}).dropna()
            if valid.empty:
                continue

            precision, recall, thresholds = precision_recall_curve(valid['val'], valid['pred'])
            thresholds = np.append(thresholds, 1.0)

            # Plot PR curve
            plt.figure(figsize=(10, 6))
            plt.plot(thresholds, precision, label='Precision', color='blue')
            plt.plot(thresholds, recall, label='Recall', color='red')

            highlight_indices = [j for j, r in enumerate(recall) if r > 0.0]
            plt.scatter(thresholds[highlight_indices], precision[highlight_indices], color='blue', s=10)
            plt.scatter(thresholds[highlight_indices], recall[highlight_indices], color='red', s=10)

            plt.xlabel('Threshold')
            plt.ylabel('Precision / Recall')
            plt.title(f"{name} - Prediction {i} - Precision-Recall vs. Threshold")
            plt.legend()
            plt.grid()
            plt.savefig(f"{folder}-{target_name}-Precision-Recall-Curve.png")
            plt.show(block=False)

            # Compute metrics per threshold
            results = []

            for t in thresholds:
                # Apply threshold to entire list
                data_frame["y-predict-binary"] = data_frame["y-predict"].apply(
                    lambda row: [int(v >= t) if v is not None else None for v in row]
                    if isinstance(row, (list, tuple)) else None
                )

                data_frame["y-value-binary"] = data_frame["y-value"].apply(
                    lambda row: [int(v >= t) if v is not None else None for v in row]
                    if isinstance(row, (list, tuple)) else None
                )

                # Extract binary i-th values
                pred_bin_i = data_frame["y-predict-binary"].apply(
                    lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
                )
                val_bin_i = data_frame["y-value-binary"].apply(
                    lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
                )

                df_valid = pd.DataFrame({'pred_bin': pred_bin_i, 'val_bin': val_bin_i}).dropna()
                if df_valid.empty:
                    continue

                TP = ((df_valid["pred_bin"] == 1) & (df_valid["val_bin"] == 1)).sum()
                FP = ((df_valid["pred_bin"] == 1) & (df_valid["val_bin"] == 0)).sum()
                FN = ((df_valid["pred_bin"] == 0) & (df_valid["val_bin"] == 1)).sum()

                precision_val = precision[np.where(thresholds == t)[0][0]]
                recall_val = recall[np.where(thresholds == t)[0][0]]
                all_values = len(df_valid)

                results.append({
                    'prediction_index': i,
                    'threshold': t,
                    'TPs': TP,
                    'FPs': FP,
                    'FNs': FN,
                    'Precision': precision_val,
                    'Recall': recall_val,
                    'Random-Guess': (TP + FN) / all_values,
                })

            df = pd.DataFrame(results)
            df = df.sort_values(by='threshold', ascending=False)
            # Create clean filename with just the target name
            df.to_csv(f"{target_name}_detailed_threshold.csv", index=False)


    def plot_roc(self, name, labels, predictions, folder, **kwargs):
        fp, tp, _ = sklearn.metrics.roc_curve(labels, predictions)

        print(fp)
        print(tp)
        plt.plot(100*fp, 100*tp, label=name, linewidth=2, **kwargs)
        plt.xlabel('False positives [%]')
        plt.ylabel('True positives [%]')
        plt.xlim([-0.5,100])
        plt.ylim([0,100])
        plt.grid(True)
        ax = plt.gca()
        ax.set_aspect('equal')

    def plot_roc_and_PR_curvers_for(self, train_data, validation_data, folder):
        colors = plt.rcParams['axes.prop_cycle'].by_key()['color']

        if self.trainer_config.is_binary_prediction:
            # Run PR curves for full validation set and by ticker
            self.plot_precision_recall_curve(validation_data, folder)
            for ticker in validation_data["Orig_Ticker"].unique():
                df_ticker = validation_data.loc[validation_data["Orig_Ticker"] == ticker]
                self.plot_precision_recall_curve(df_ticker, folder, name=ticker)

            # Determine how many prediction indices we have
            max_len = validation_data['y-predict-original'].apply(
                lambda val: len(val) if isinstance(val, (list, tuple)) else 0
            ).max()

            # Plot ROC for each prediction index i
            for i in range(max_len):
                # Get i-th prediction and target from lists
                train_y_true = train_data['y-value'].apply(
                    lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
                )
                train_y_pred = train_data['y-predict'].apply(
                    lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
                )
                val_y_true = validation_data['y-value-original'].apply(
                    lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
                )
                val_y_pred = validation_data['y-predict-original'].apply(
                    lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
                )

                # Drop NAs for each
                train_df = pd.DataFrame({'y_true': train_y_true, 'y_pred': train_y_pred}).dropna()
                val_df = pd.DataFrame({'y_true': val_y_true, 'y_pred': val_y_pred}).dropna()

                # Skip if empty
                if train_df.empty or val_df.empty:
                    continue

                # Plot ROC curves
                plt.figure(figsize=(10, 6))
                self.plot_roc(f"Train Prediction {i}", train_df['y_true'], train_df['y_pred'], folder, color=colors[i % len(colors)])
                self.plot_roc(f"Test Prediction {i}", val_df['y_true'], val_df['y_pred'], folder, color=colors[i % len(colors)], linestyle='--')
                plt.legend(loc='lower right')
                plt.title(f"ROC Curve - Prediction {i}")
                plt.grid()
                plt.savefig(f"{folder}-Roc-Curve-Prediction-{i}.png")
                plt.show(block=False)

            

    def find_best_threshold(self, data, beta=0.5):
        # Determine the max length of prediction lists
        max_len = data["y-predict"].apply(lambda x: len(x) if isinstance(x, (list, tuple)) else 0).max()
        
        best_thresholds = {}

        for i in range(max_len):
            # Flatten i-th prediction index across all rows
            y_true_i = data["y-value"].apply(
                lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
            )
            y_pred_i = data["y-predict"].apply(
                lambda x: x[i] if isinstance(x, (list, tuple)) and len(x) > i else None
            )

            # Drop missing values
            valid = pd.DataFrame({"y_true": y_true_i, "y_pred": y_pred_i}).dropna()
            if valid.empty:
                best_thresholds[i] = None
                continue

            # Compute precision, recall, thresholds
            precision, recall, thresholds = precision_recall_curve(valid["y_true"], valid["y_pred"])

            if len(thresholds) == 0:
                best_thresholds[i] = None
                continue

            # Compute Fβ-Score
            fbeta_scores = (1 + beta**2) * (precision * recall) / (beta**2 * precision + recall + 1e-10)

            # Get best threshold
            best_index = np.argmax(fbeta_scores)
            best_threshold = thresholds[best_index]
            best_thresholds[i] = best_threshold

        return best_thresholds


    def find_threshold_and_calculate_for(self, data, folder):
        if self.trainer_config.is_binary_prediction:
            best_threshold = self.find_best_threshold(data)
            print(f"Best threshold: {best_threshold}")
        
            ticker_thresholds = pd.DataFrame()
            for sector in data["Orig_Ticker"].unique():
                val = self.find_best_threshold(data[data["Orig_Ticker"] == sector])
                # Just save the first threshold value if it's a dictionary
                threshold_value = val[0] if isinstance(val, dict) else val
                ticker_thresholds = pd.concat([ticker_thresholds, pd.DataFrame({"Ticker": [sector], "Threshold": [threshold_value]})], ignore_index=True)
            ticker_thresholds.to_csv(folder + "_threshold.csv", index=False)
            
            return self.calculate_for(data, folder, val=best_threshold)
            
        else:
            if use_pre_calc_sigma:
                self.calculate_for(data, folder, min_threshold=0.01, max_threshold= 2.0)
                self.calculate_for(data, folder, min_threshold=0.0125, max_threshold= 2.0)
                self.calculate_for(data, folder, min_threshold=0.015, max_threshold= 2.0)
                self.calculate_for(data, folder, min_threshold=0.0175, max_threshold= 2.0)
                self.calculate_for(data, folder, min_threshold=0.02, max_threshold= 2.0)
                self.calculate_for(data, folder, min_threshold=0.0225, max_threshold= 2.0)
                return self.calculate_for(data, folder, min_threshold=0.025, max_threshold= 2.0)
            else:
                print(two_sigma_cap_per_ticker)
                return self.calculate_for(data, folder, two_sigma_cap_per_ticker=two_sigma_cap_per_ticker)
                

    def plot_training_history(self, history, folder):
        # Extract metrics from the history object
        training_loss = history.history['loss']
        validation_loss = history.history.get('val_loss')  # May be None if no validation data
        training_AUC = history.history.get('AUC-ROC')  # For classification tasks
        validation_AUC = history.history.get('val_AUC-ROC')  # May be None if no validation data
        training_AUC_PR = history.history.get('AUC-PR')  # For classification tasks
        validation_AUC_PR = history.history.get('val_AUC-PR')  # May be None if no validation data
        
        # Plot Loss
        plt.figure(figsize=(10, 5))
        plt.plot(training_loss, label='Training Loss', marker='o')
        if validation_loss:
            plt.plot(validation_loss, label='Validation Loss', marker='o')
        plt.title('Loss Over Epochs')
        plt.xlabel('Epochs')
        plt.ylabel('Loss')
        plt.savefig(folder + "-loss-val-loss-over-epochs")
        plt.legend()
        plt.grid(True)
        plt.show(block=False)

        if self.trainer_config.is_binary_prediction:
            plt.figure(figsize=(10, 5))
            plt.plot(training_AUC, label='Training AUC', marker='o')
            if validation_AUC:
                plt.plot(validation_AUC, label='Validation AUC', marker='o')
            plt.title('AUC Over Epochs')
            plt.xlabel('Epochs')
            plt.ylabel('AUC')
            plt.savefig(folder + "-AUC-val-AUC-over-epochs")
            plt.legend()
            plt.grid(True)
            plt.show(block=False)
            
            plt.figure(figsize=(10, 5))
            plt.plot(training_AUC_PR, label='Training AUC-PR', marker='o')
            if validation_AUC_PR:
                plt.plot(validation_AUC_PR, label='Validation AUC-PR', marker='o')
            plt.title('AUC-PR Over Epochs')
            plt.xlabel('Epochs')
            plt.ylabel('AUC-PR')
            plt.savefig(folder + "-AUC-PR-val-AUC-PR-over-epochs")
            plt.legend()
            plt.grid(True)
            plt.show(block=False)


    def calculate_predictions(self, train_data, validation_data, y_train_predict, y_validate_predict, real_target, stock, folder_path, quantile_or_target, target_index=None):
        
        # Handle multiple targets correctly when we have actual multi-target predictions
        if isinstance(real_target, list):
            # For validation data
            validation_data['y-predict'] = y_validate_predict.tolist()
            
            # For each target, denormalize its predictions with its own parameters
            for ticker in validation_data["Orig_Ticker"].unique():
                y_pred_list = []
                for i, target in enumerate(real_target):
                    # Extract predictions for this target index
                    target_preds = validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict'].apply(lambda x: x[i])
                    target_df = pd.DataFrame(target_preds.tolist(), columns=["y-predict"])
                    
                    # If it's a binary target (starts with "DM_"), don't denormalize
                    if target.startswith("DM_"):
                        y_pred_list.append(target_df["y-predict"].tolist())
                    else:
                        denorm_preds = inverse_normalize_data(target_df, ticker, target)
                        if denorm_preds is not None:
                            y_pred_list.append(denorm_preds.values.flatten().tolist())
                        else:
                            # Fallback to original predictions if denormalization fails
                            y_pred_list.append(target_df["y-predict"].tolist())
                
                # Transpose to get back to row-wise format
                if y_pred_list:
                    transposed_preds = list(map(list, zip(*y_pred_list)))
                    validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict-original'] = transposed_preds
                else:
                    validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict-original'] = validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict']
            
            # Same process for training data
            train_data['y-predict'] = y_train_predict.tolist()
            
            for ticker in train_data["Orig_Ticker"].unique():
                y_pred_list = []
                for i, target in enumerate(real_target):
                    target_preds = train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict'].apply(lambda x: x[i])
                    target_df = pd.DataFrame(target_preds.tolist(), columns=["y-predict"])
                    
                    # If it's a binary target (starts with "DM_"), don't denormalize
                    if target.startswith("DM_"):
                        y_pred_list.append(target_df["y-predict"].tolist())
                    else:
                        denorm_preds = inverse_normalize_data(target_df, ticker, target)
                        if denorm_preds is not None:
                            y_pred_list.append(denorm_preds.values.flatten().tolist())
                        else:
                            # Fallback to original predictions if denormalization fails
                            y_pred_list.append(target_df["y-predict"].tolist())
                
                # Transpose to get back to row-wise format
                if y_pred_list:
                    transposed_preds = list(map(list, zip(*y_pred_list)))
                    train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict-original'] = transposed_preds
                else:
                    train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict-original'] = train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict']
        else:
            # Single target case (including individual targets from multi-target processing)
            validation_data['y-predict'] = [[pred] for pred in y_validate_predict.flatten().tolist()]
            train_data['y-predict'] = [[pred] for pred in y_train_predict.flatten().tolist()]
            
            # For individual targets from multi-target processing, we need to extract the specific target's real values too
            # This assumes that when real_target is a single string, we're processing one target from a multi-target setup
            # and the original y-value contains all targets, so we need to extract the correct target index
            if not isinstance(real_target, list) and target_index is not None:
                # Update y-value to show only the specific target (target_index) from the original multi-target data
                validation_data['y-value'] = validation_data['y-value-original'].apply(
                    lambda x: [x[target_index]] if isinstance(x, (list, tuple)) and len(x) > target_index else [x]
                )
                train_data['y-value'] = train_data['y-value-original'].apply(
                    lambda x: [x[target_index]] if isinstance(x, (list, tuple)) and len(x) > target_index else [x]
                )
            
            # For single targets, denormalize with the target's parameters
            for ticker in validation_data["Orig_Ticker"].unique():
                target_preds = validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict'].apply(lambda x: x[0])
                target_df = pd.DataFrame(target_preds.tolist(), columns=["y-predict"])
                
                # If it's a binary target (starts with "DM_"), don't denormalize
                if real_target.startswith("DM_"):
                    validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict-original'] = validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict']
                else:
                    denorm_preds = inverse_normalize_data(target_df, ticker, real_target)
                    if denorm_preds is not None:
                        validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict-original'] = [[pred] for pred in denorm_preds.values.flatten().tolist()]
                    else:
                        validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict-original'] = validation_data.loc[validation_data["Orig_Ticker"] == ticker, 'y-predict']
            
            # Same for training data
            for ticker in train_data["Orig_Ticker"].unique():
                target_preds = train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict'].apply(lambda x: x[0])
                target_df = pd.DataFrame(target_preds.tolist(), columns=["y-predict"])
                
                # If it's a binary target (starts with "DM_"), don't denormalize
                if real_target.startswith("DM_"):
                    train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict-original'] = train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict']
                else:
                    denorm_preds = inverse_normalize_data(target_df, ticker, real_target)
                    if denorm_preds is not None:
                        train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict-original'] = [[pred] for pred in denorm_preds.values.flatten().tolist()]
                    else:
                        train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict-original'] = train_data.loc[train_data["Orig_Ticker"] == ticker, 'y-predict']

        if self.trainer_config.do_stock_by_stock:
            label = stock + "+" + str(quantile_or_target)
        else:
            label = "All stocks" + "+" + str(quantile_or_target)

        # Use the folder path as provided, optionally append quantile
        final_folder = folder_path + str(quantile_or_target) if str(quantile_or_target) != "" else folder_path
        
        # For single target processing (individual targets from multi-target), only plot target index 0
        # For true multi-target processing, plot all targets
        if isinstance(real_target, list):
            # True multi-target case - plot all targets
            self.print_and_save_for(train_data, "Train", final_folder, label=label)
            self.print_and_save_for(validation_data, "Validation", final_folder, label=label)
        else:
            # Single target case (including individual targets from multi-target processing) - plot only index 0
            self.print_and_save_for(train_data, "Train", final_folder, label=label, target_index=0)
            self.print_and_save_for(validation_data, "Validation", final_folder, label=label, target_index=0)
        
        self.plot_roc_and_PR_curvers_for(train_data, validation_data, final_folder)
        self.find_threshold_and_calculate_for(validation_data, final_folder)

