def calculate_loss(loss_function, weight_ratio = 0.0):
    loss = None
    loss_name = None
    
    if loss_function == "mse":
        loss = "mse"
        loss_name = "mse"
    elif loss_function == "focal":
        loss = focal_loss(alpha=0.25, gamma=2.0)
        loss_name = "focal_loss"
    elif loss_function == "mae":
        loss = "mae"
        loss_name = "mae"
    elif loss_function == "cubic":
        loss = cubic_loss(power=3)
        loss_name="cubic"
    elif loss_function == "square":
        loss = cubic_loss(power=0.5)
        loss_name="square"
    elif loss_function == "weighted_bce":
        loss = weighted_bce(ratio=weight_ratio)
        loss_name="weighted_bce"
    elif loss_function == "rifat":
        loss = rifat_loss(ratio=weight_ratio)
        loss_name="rifat"
    else:
        loss = "binary_crossentropy"
        loss_name = "binary_crossentropy"
        
    print(f"loss: {loss}, loss_name: {loss_name}")
    return loss, loss_name

def SEQUENCE_SIZE(mode):
    if mode == "simple":
        return 17
    elif mode == "medium":
        return 33
    elif mode == "complex":
        return 65
    elif mode == "experimental":
        return 91
    elif mode == "experimental_v2":
        return 29
    elif mode == "experimental_v3":
        return 29
    elif mode == "experimental_v4":
        return 1
    elif mode == "experimental_v5":
        return 1
    elif mode == "experimental_v6":
        return 1
    elif mode == "simple_v2":
        return 9
    elif mode == "simple_v3":
        return 17
        # return 144
    else:
        print(f"UNKNOWN MODE, pick either simple, medium or complex")
        return 0


def remove_if_neighbors_true(df, col='flag', n=4):
    if col not in df.columns:
        raise KeyError(f"Column '{col}' does not exist in DataFrame.")

    mask = pd.Series(False, index=df.index)
    for i in range(-n, n + 1):
        if i != 0:
            shifted = df[col].shift(i, fill_value=False).fillna(False).astype(bool)
            mask |= shifted
    return df[~mask]


class TrainerConfig:
    def __init__(self, l2_rate,
                        initial_learning_rate,
                        decay_ratio,
                        decay_interval,
                        early_stop_epoch,
                        early_stop_delta,
                        early_stop_monitor_metric,
                        early_stop_monitor_mode,
                        initial_dropout_rate,
                        dropout_rate_decay,
                        number_of_epochs=2000,
                        use_fixed_mean=True,
                        loss_function=None,
                        save_best_metric=None,
                        save_best_mode=None,
                        training_seed=None,
                        stocks=None,
                        is_binary_prediction=True,
                        clip_by_3_sigma=True,
                        do_stock_by_stock=True,
                        network_type=None,
                        underlying_target=None,
                        refresh_data=False,
                        do_shuffle_for_train_data=False,
                        use_extra_dense_layers=False,
                        batch_size = 128,
                        wait_to_save = 80,
                        remove_earning_dates = False,
                        binary_target_ma_period = 20,
                        train_start_date = "2021-03-01",
                        validation_start_date = "2024-11-13",
                        test_start_date = "2025-02-26",
                        incl_earnings=True,
                        data_interval="2y",
                        filter_by_vix=False):
        self.l2_rate = l2_rate
        self.initial_learning_rate = initial_learning_rate
        self.decay_ratio = decay_ratio
        self.decay_interval = decay_interval
        self.early_stop_epoch = early_stop_epoch
        self.early_stop_delta = early_stop_delta
        self.early_stop_monitor_metric = early_stop_monitor_metric
        self.early_stop_monitor_mode = early_stop_monitor_mode
        self.sequence_len = SEQUENCE_SIZE(network_type)
        self.number_of_epochs = number_of_epochs
        self.use_fixed_mean = use_fixed_mean
        self.initial_dropout_rate = initial_dropout_rate
        self.dropout_rate_decay = dropout_rate_decay
        self.loss_function = loss_function
        self.save_best_metric = save_best_metric
        self.save_best_mode = save_best_mode
        self.training_seed = training_seed
        self.stocks = stocks
        self.is_binary_prediction = is_binary_prediction
        self.clip_by_3_sigma = clip_by_3_sigma
        self.do_stock_by_stock = do_stock_by_stock
        self.network_type = network_type
        self.underlying_target = underlying_target
        self.refresh_data = refresh_data
        self.do_shuffle_for_train_data = do_shuffle_for_train_data
        self.batch_size = batch_size
        self.wait_to_save = wait_to_save
        self.remove_earning_dates = remove_earning_dates
        self.use_extra_dense_layers = use_extra_dense_layers
        self.binary_target_ma_period = binary_target_ma_period
        self.train_start_date = train_start_date
        self.validation_start_date = validation_start_date
        self.test_start_date = test_start_date
        self.incl_earnings = incl_earnings
        self.data_interval = data_interval
        self.filter_by_vix = filter_by_vix


    def dropout_rate(self, layer):
        return self.initial_dropout_rate * (self.dropout_rate_decay ** (layer - 1))
    
class Trainer:
    def __init__(self, trainer_config):
        self.trainer_config = trainer_config
                        
    def setup_for_training(self):

        SEED = self.trainer_config.training_seed  # Any fixed number
        
        tf.keras.utils.set_random_seed(SEED)
        np.random.seed(SEED)
        random.seed(SEED)
        tf.config.experimental.enable_op_determinism()  # Ensures consistent behavior

        
        os.environ['TF_CPP_MIN_LOG_LEVEL'] = '2'
        tf.get_logger().setLevel('ERROR')
        # Suppress absl.logging (used internally by TensorFlow)
        logging.getLogger('absl').setLevel(logging.ERROR)

    def load_and_filter_by_vix(self, data_frame):
        """
        Load VIX data and filter out dates where VIX > 22
        """
        if not self.trainer_config.filter_by_vix:
            return data_frame
        
        try:
            # Load VIX data
            vix_data = pd.read_csv("../data/vix_values.csv")
            
            # Extract just the date part from the datetime string (YYYY-MM-DD)
            vix_data['Date_only'] = vix_data['Date'].str[:10]
            
            # Filter VIX data for Close > 22
            high_vix_dates = vix_data[vix_data['Close'] > 22]['Date_only'].tolist()
            
            print(f"Found {len(high_vix_dates)} dates with VIX > 22")
            print(f"Data size before VIX filtering: {len(data_frame)}")
            
            # Extract date part from data_frame Date column (assuming it's also datetime string or date)
            if data_frame['Date'].dtype == 'object':
                data_frame['Date_only'] = data_frame['Date'].astype(str).str[:10]
            else:
                data_frame['Date_only'] = pd.to_datetime(data_frame['Date']).dt.strftime('%Y-%m-%d')
            
            # Filter out high VIX dates
            data_frame = data_frame[~data_frame['Date_only'].isin(high_vix_dates)]
            
            # Drop the temporary column
            data_frame = data_frame.drop('Date_only', axis=1)
            
            print(f"Data size after VIX filtering: {len(data_frame)}")
            
            return data_frame
            
        except Exception as e:
            print(f"Error loading VIX data: {e}")
            print("Continuing without VIX filtering...")
            return data_frame



