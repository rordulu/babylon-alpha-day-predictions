            # cnn = TimeDistributed(Dense(16, activation='relu', kernel_regularizer=l2(self.trainer_config.l2_rate)))(cnn)  # (65, 8)
            cnn = input_layer
            
            # cnn = tf.keras.layers.Conv1D(128,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
