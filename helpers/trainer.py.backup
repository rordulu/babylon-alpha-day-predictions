    def create_model_experimental_v3(self, train_data):
        ### MODEL 1
        from tensorflow.keras.layers import Concatenate, ZeroPadding1D, Cropping1D, Embedding, RepeatVector, Input, Reshape, Conv1D, PReLU, LSTM, Dropout, Dense, Flatten
        
        input_data = train_data.iloc[0]["LstmData"]
        print(input_data.shape)
        
        input_layer = tf.keras.layers.Input(shape=(input_data.shape[0], input_data.shape[1]), name="lstm-values")
        stock_id_input = tf.keras.layers.Input(shape=(1,), name="stock_id")  # Stock ID input
        sector_input = tf.keras.layers.Input(shape=(1,), name="sector_id")  # Sector ID input
        prev_day_input = tf.keras.layers.Input(shape=(len(lstm_features),), name="prev-day-values")
        
        cnn = input_layer
        
        cnn = tf.keras.layers.Conv1D(64,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
        
        cnn = tf.keras.layers.Conv1D(64,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
        
        cnn = tf.keras.layers.Conv1D(128,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
        
        cnn = tf.keras.layers.Conv1D(128,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
        
        cnn = tf.keras.layers.Conv1D(256,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
        
        cnn = tf.keras.layers.Conv1D(256,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
        cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
        
        cnn = tf.keras.layers.Flatten()(cnn)
        
        lstm = cnn

        lstm = tf.keras.layers.Dense(1000, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
        lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        lstm = tf.keras.layers.Dropout(rate = DROPOUT_RATE(mode, 1))(lstm)
        
        # lstm = tf.keras.layers.Dense(400, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
        # lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        # lstm = tf.keras.layers.Dropout(rate = DROPOUT_RATE(mode, 2))(lstm)
        
        lstm = tf.keras.layers.Dense(100, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
        lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        
        if self.trainer_config.is_binary_prediction:
            lstm = tf.keras.layers.Dense(1, activation='sigmoid')(lstm)
        elif self.trainer_config.use_quantiles:
            lstm = tf.keras.layers.Dense(len(quantiles))(lstm)
        else:
            lstm = tf.keras.layers.Dense(1)(lstm)
        regressor = tf.keras.models.Model([input_layer, stock_id_input, sector_input, prev_day_input],lstm)
        regressor.summary()
        plot_model(regressor, to_file='regressor_tree.png', show_shapes=True, show_layer_names=True)
        return regressor
        
    def create_model_experimental_v2(self, train_data):
        ### MODEL 1
        from tensorflow.keras.layers import Concatenate, ZeroPadding1D, Cropping1D, Embedding, RepeatVector, Input, Reshape, Conv1D, PReLU, LSTM, Dropout, Dense, Flatten
        
        input_data = train_data.iloc[0]["LstmData"]
        print(input_data.shape)
        
        input_layer = tf.keras.layers.Input(shape=(input_data.shape[0], input_data.shape[1]), name="lstm-values")
        stock_id_input = tf.keras.layers.Input(shape=(1,), name="stock_id")  # Stock ID input
        sector_input = tf.keras.layers.Input(shape=(1,), name="sector_id")  # Sector ID input
        prev_day_input = tf.keras.layers.Input(shape=(len(lstm_features),), name="prev-day-values")
        


        if network_type == "cnn" or network_type == "lstm+cnn":

            cnn = input_layer
            
            cnn = tf.keras.layers.Conv1D(16,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
            cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
            
            cnn = tf.keras.layers.Conv1D(16,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
            cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
            
            cnn = tf.keras.layers.Conv1D(32,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
            cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
            
            cnn = tf.keras.layers.Conv1D(32,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
            cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
            
            cnn = tf.keras.layers.Conv1D(64,3, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
            cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
            
            cnn = tf.keras.layers.Conv1D(64,3, strides=2, kernel_regularizer=l2(self.trainer_config.l2_rate))(cnn)
            cnn = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.0))(cnn)
            
            cnn = tf.keras.layers.Flatten()(cnn)
        else:
            cnn = input_layer
        
        lstm = cnn

        lstm = tf.keras.layers.Dense(2000, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
        lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        lstm = tf.keras.layers.Dropout(rate = DROPOUT_RATE(mode, 1))(lstm)
        
        lstm = tf.keras.layers.Dense(800, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
        lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        lstm = tf.keras.layers.Dropout(rate = DROPOUT_RATE(mode, 2))(lstm)
        
        lstm = tf.keras.layers.Dense(100, kernel_regularizer=l2(self.trainer_config.l2_rate))(lstm)
        lstm = tf.keras.layers.PReLU(shared_axes=[1], alpha_initializer=tf.initializers.constant(0.2))(lstm)
        
        if self.trainer_config.is_binary_prediction:
            lstm = tf.keras.layers.Dense(1, activation='sigmoid')(lstm)
        elif self.trainer_config.use_quantiles:
            lstm = tf.keras.layers.Dense(len(quantiles))(lstm)
        else:
            lstm = tf.keras.layers.Dense(1)(lstm)
        regressor = tf.keras.models.Model([input_layer, stock_id_input, sector_input, prev_day_input],lstm)
        regressor.summary()
        plot_model(regressor, to_file='regressor_tree.png', show_shapes=True, show_layer_names=True)
        return regressor
        
    def create_model_experimental(self, train_data):
        ### MODEL 1
        from tensorflow.keras.layers import Concatenate, ZeroPadding1D, Cropping1D, Embedding, RepeatVector, Input, Reshape, Conv1D, PReLU, LSTM, Dropout, Dense, Flatten
        
        input_data = train_data.iloc[0]["LstmData"]
