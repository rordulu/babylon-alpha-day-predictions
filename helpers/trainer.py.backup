                data_frame = data_frame.drop(data_frame[((data_frame["Orig_Ticker"] == ticker) & (data_frame["yesterday_evening_earning_day"] == 1.0))].index)
                print(f"size after earning yesterday_evening_earning_day removal application: {len(data_frame)} for ticker: {ticker}")
                data_frame = data_frame.drop(data_frame[((data_frame["Orig_Ticker"] == ticker) & (data_frame["yesterday_evening_earning_day"] == 1.0))].index)
                print(f"size after earning yesterday_evening_earning_day removal application: {len(data_frame)} for ticker: {ticker}")
    
        if self.trainer_config.do_shuffle_for_train_data:
            train_data, validation_data, test_data = split_data(data_frame,
                                                            train_cut_date = "2024-11-30",
                                                            validate_cut_date = "2024-11-30",
                                                            test_end_date = "2024-12-30",
                                                               # train_start_date = "2023-01-01"
                                                               )
            print(f"1. Train data length: {len(train_data)}")
