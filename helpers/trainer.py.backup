            print(f"2. Train data length: {len(train_data)}")
            print(f"2. Validation data length: {len(validation_data)}")
        else:
            train_data, validation_data, test_data = split_data(data_frame,
                                                                train_cut_date = self.trainer_config.validation_start_date,
                                                                validate_cut_date = self.trainer_config.test_start_date,
                                                                test_end_date = "2025-02-28",
                                                                train_start_date = self.trainer_config.train_start_date
                                                                   )
            # train_data, validation_data, test_data = split_data(data_frame,
